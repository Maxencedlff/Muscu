<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Trousseau partagé avec l'app : le widget y lit l'instantané laissé par l'app
	     (Shared/CompanionShared.swift, SharedKeychain) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.mdlf.training.shared</string>
	</array>
</dict>
</plist>
