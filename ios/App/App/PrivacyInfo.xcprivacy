<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manifeste de confidentialité exigé par Apple : aucun suivi. Données collectées seulement avec le compte
	     facultatif (js/data/account.js), pour synchroniser les appareils (et, sur inscription, pour la lettre d'information) : identifiant (dont le pseudo), adresse
	     e-mail (comptes e-mail et Google seulement), nom (comptes Google seulement), séances, notes et avatar (un emoji).
	     Jamais de donnée d'Apple Santé. Poids du corps : seulement les pesées saisies dans l'app, si l'élève
	     choisit de les partager avec son coach (js/data/coach-share.js), d'où le type Health ci-dessous.
	     Même déclaration dans App Store Connect et privacy.html. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Identifiant du compte (Supabase), identifiant anonyme fourni par « Se connecter avec Apple » et pseudo
			     choisi dans l'app (identifiant visible, unique) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Adresse e-mail : connexion par code e-mail, ou donnée par Google à la connexion avec Google.
			     Sert à se connecter (envoi du code par Resend) et, seulement si la personne s'y inscrit elle-même
			     (Réglages › Compte), à la lettre d'information de l'app (marketing du développeur,
			     docs/NEWSLETTER.md). Jamais de publicité de tiers ni de suivi. Même déclaration dans App Store
			     Connect (Adresse e-mail : Fonctionnalité de l'app, Publicité ou marketing du développeur) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
		<dict>
			<!-- Nom : Google le transmet à la connexion avec Google, et Supabase Auth le garde avec le compte
			     (raw_user_meta_data, avec l'adresse de la photo du profil Google). L'app ne l'affiche ni ne
			     l'utilise : seul le pseudo sert de nom. Déclaré parce qu'il est stocké avec le compte -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Santé : pesées (date et poids) et mensurations saisies dans l'app, envoyées seulement si l'élève coche
			     « Poids du corps » ou « Mensurations » dans Réglages › Partager avec mon coach, vues seulement par ce
			     coach, effacées au retrait (supabase/migrations/20261031300000_partage_coach.sql,
			     20261105010000_partage_mensurations.sql). Jamais une donnée lue dans Apple Santé -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Séances d'entraînement : exercices, séries, charges, répétitions, durées, programmes -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Abonnement (StorePlugin.swift) : la transaction signée par Apple est envoyée à l'Edge Function
			     verify-purchase, qui garde le produit acheté, la date de fin et l'identifiant de transaction
			     avec le compte (table entitlements). Jamais de publicité ni de suivi ; aucun moyen de paiement
			     ne passe par l'app (Apple encaisse). À reporter dans App Store Connect
			     (Confidentialité de l'app › Achats › Historique des achats). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<!-- Prix payés : calcul des commissions de parrainage (subscription_payments) -->
				<string>NSPrivacyCollectedDataTypePurposeOther</string>
			</array>
		</dict>
		<dict>
			<!-- Notes de séance, noms d'exercices ou de programmes saisis, plans diète (créés ou envoyés par le
			     coach, js/data/coach-diet.js ; le journal des repas reste sur l'appareil), signalements d'un
			     compte (fonction report), avatar (emoji) du compte -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Photos de bilan envoyées par l'élève lui-même à son coach (docs/PHOTOS_BILAN.md) : redessinées sans
			     métadonnées puis chiffrées sur l'iPhone pour ce seul coach ; le serveur garde le fichier chiffré, le
			     jour, la pose et la date de l'accord. Les photos du coffre restent sur l'iPhone. Même déclaration
			     dans App Store Connect (Photos ou vidéos : Fonctionnalité de l'app) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Messages entre un coach et son élève (chat_coach) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Jeton APNs gardé avec le compte quand une notification push est allumée -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Version de l'app et date de dernière ouverture envoyées avec le profil -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Demande coach : numéro de carte professionnelle et diplôme -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!-- Bips (SoundPlugin.swift, build 68) : délais de la file audio seulement, aucune horloge système
	     (ProcessInfo.systemUptime, mach_absolute_time) ; le journal des incidents audio reste sur l'iPhone. -->
	<!-- Lecteur de code-barres (ScannerPlugin.swift, AVFoundation) : les images de la caméra restent sur l'iPhone,
	     aucune API à raison déclarée. Seul le numéro lu part vers Open Food Facts (js/data/food-scan.js), sans
	     identifiant ni compte : rien de lié à la personne, donc aucun type de donnée collectée à ajouter. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Préférences (UserDefaults) utilisées par la coquille et ses modules, pour l'app elle-même -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Dates de fichiers lues par le module Filesystem (copie de sécurité dans les Documents de l'app) -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Espace libre lu par le module de mises à jour (Capgo, CapgoUpdater.checkDiskSpace) avant d'écrire un paquet : le téléchargement est refusé si l'espace manque -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
