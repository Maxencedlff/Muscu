<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manifeste de confidentialité exigé par Apple : aucun suivi. Données collectées seulement avec le compte
	     facultatif (js/data/account.js), pour synchroniser les appareils (et, sur inscription, pour la lettre d'information) : identifiant (dont le pseudo), adresse
	     e-mail (comptes e-mail et Google seulement), nom (comptes Google seulement), séances, notes et avatar (un emoji).
	     Jamais de donnée de Santé ni de poids du corps. Même déclaration dans App Store Connect et privacy.html. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Identifiant du compte (Supabase), identifiant anonyme fourni par « Se connecter avec Apple » et pseudo
			     choisi dans l'app (identifiant visible, unique) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Adresse e-mail : connexion par code e-mail, ou donnée par Google à la connexion avec Google.
			     Sert à se connecter (envoi du code par Resend) et, seulement si la personne s'y inscrit elle-même
			     (Réglages › Compte), à la lettre d'information de l'app (marketing du développeur,
			     docs/NEWSLETTER.md). Jamais de publicité de tiers ni de suivi. Même déclaration dans App Store
			     Connect (Adresse e-mail : Fonctionnalité de l'app, Publicité ou marketing du développeur) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
		<dict>
			<!-- Nom : Google le transmet à la connexion avec Google, et Supabase Auth le garde avec le compte
			     (raw_user_meta_data, avec l'adresse de la photo du profil Google). L'app ne l'affiche ni ne
			     l'utilise : seul le pseudo sert de nom. Déclaré parce qu'il est stocké avec le compte -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Séances d'entraînement : exercices, séries, charges, répétitions, durées, programmes -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Abonnement (StorePlugin.swift) : la transaction signée par Apple est envoyée à l'Edge Function
			     verify-purchase, qui garde le produit acheté, la date de fin et l'identifiant de transaction
			     avec le compte (table entitlements). Jamais de publicité ni de suivi ; aucun moyen de paiement
			     ne passe par l'app (Apple encaisse). À reporter dans App Store Connect
			     (Confidentialité de l'app › Achats › Historique des achats). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Notes de séance, noms d'exercices ou de programmes saisis, avatar (emoji) du compte -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Préférences (UserDefaults) utilisées par la coquille et ses modules, pour l'app elle-même -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Dates de fichiers lues par le module Filesystem (copie de sécurité dans les Documents de l'app) -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Espace libre lu par le module de mises à jour (Capgo, CapgoUpdater.checkDiskSpace) avant d'écrire un paquet : le téléchargement est refusé si l'espace manque -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
