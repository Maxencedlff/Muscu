<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Santé : écriture des entraînements, lecture du poids -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Compte MDLF : connexion avec Apple (AccountPlugin.swift) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Notifications push (PushPlugin.swift) : production pour TestFlight et l'App Store. La capacité
	     « Push Notifications » doit être activée sur l'identifiant com.mdlf.training et le profil App Store
	     régénéré avant la build (docs/BUILD.md), sinon la signature échoue. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Copie des données dans l'iCloud de l'utilisateur (CloudBackupPlugin.swift) -->
	<!-- Trousseau : le groupe de l'app d'abord (groupe par défaut de ses éléments, comme avant), puis le
	     groupe partagé avec l'extension RestActivity (instantané du widget, Shared/CompanionShared.swift) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.mdlf.training</string>
		<string>$(AppIdentifierPrefix)com.mdlf.training.shared</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
