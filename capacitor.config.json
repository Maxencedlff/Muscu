{
  "appId": "com.mdlf.training",
  "appName": "MDLF Training",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "LocalNotifications": {
      "presentationOptions": [
        "alert",
        "sound"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "appReadyTimeout": 10000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    }
  }
}
